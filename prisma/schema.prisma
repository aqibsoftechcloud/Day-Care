  updated_at  DateTime             @default(now()) @db.Timestamp(0)
  hospitals   hospitals            @relation(fields: [hospital_id], references: [id], onDelete: Cascade, map: "fk_hospital_faqs_hospital")

  @@index([hospital_id], map: "idx_hospital_faqs_hospital_id")
  @@index([status], map: "idx_hospital_faqs_status")
