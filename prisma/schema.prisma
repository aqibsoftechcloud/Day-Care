model hospitals {
  id                           Int                            @id @default(autoincrement()) @db.UnsignedInt
  hospital_name                String                         @db.VarChar(255)
  city_id                      Int                            @db.UnsignedInt
  location_id                  Int?                           @db.UnsignedInt
  meta_title                   String?                        @db.VarChar(255)
  meta_description             String?                        @db.Text
  meta_keywords                String?                        @db.VarChar(500)
  seo_url                      String                         @unique(map: "uq_hospitals_seo_url") @db.VarChar(255)
  phone_number                 String?                        @db.VarChar(50)
  timings                      String?                        @db.VarChar(255)
  address                      String?                        @db.Text
  hospital_image               String?                        @db.VarChar(500)
  google_reviews               Decimal?                       @db.Decimal(3, 1)
  patient_satisfaction_score   Decimal?                       @db.Decimal(5, 2)
  location_360_view            String?                        @db.VarChar(1000)
  location_map                 String?                        @db.Text
  hospital_description         String?                        @db.Text
  long_description             String?                        @db.LongText
  hospital_gallery             Json?
  status                       hospitals_status               @default(active)
  created_at                   DateTime                       @default(now()) @db.Timestamp(0)
  updated_at                   DateTime                       @default(now()) @db.Timestamp(0)
  doctor_hospitals             doctor_hospitals[]
  hospital_faqs                hospital_faqs[]
  cities                       cities                         @relation(fields: [city_id], references: [id], map: "fk_hospitals_city")
  locations                    locations?                     @relation(fields: [location_id], references: [id], onDelete: Restrict, map: "fk_hospitals_location")
  specialities                 specialities[]
  testimonials                 testimonials[]
  treatments                   treatments[]
  gallery                      gallery[]
  hospital_sections            hospital_sections[]
  hospital_insurance_companies hospital_insurance_companies[]

  @@index([city_id], map: "idx_hospitals_city_id")
  @@index([location_id], map: "idx_hospitals_location_id")
  @@index([status], map: "idx_hospitals_status")
}

/**
 * Hospital-side mirror of `treatment_sections`/`speciality_sections` —
 * same exact architecture (one JSON `content` column shared by every
 * content-bearing type, `section_type` as a controlled enum, no DB-level
 * uniqueness on (hospital_id, section_type) so unlimited `custom` rows
 * are allowed, application-layer guarantee of exactly one row per fixed
 * type via getOrCreateHospitalSections()).
 * Deliberately a SMALLER fixed-type set than Treatment/Speciality:
 * Hospital's locked public UI has no dedicated Highlights/Symptoms/
 * Options/Process/etc. sections to back. `hero`/`overview`/`disclaimer`
 * have no configurable `content` at all (same as Treatment's own
 * `hero`/`overview`/`symptoms`/`doctors`/`hospital`/`faqs` types) — they
 * exist here purely so an admin can toggle them active/inactive; their
 * actual text always comes from `hospitals`' own core columns (name,
 * address, hospital_description) or, for `disclaimer`, fixed interface
 * copy, never a second copy of that content. Only `why_choose_us` and
 * `cta` carry real structured content, and `custom` is open-ended.
 * Gallery/Specialities/Treatments/Doctors/Reviews/FAQs/Insurance each
 * stay owned by their own proper relational table — never duplicated
 * into this table's `content` JSON.
 */
model hospital_sections {
  id            Int                            @id @default(autoincrement()) @db.UnsignedInt
  hospital_id   Int                            @db.UnsignedInt
  section_type  hospital_sections_section_type
  section_order Int                            @default(0)
  status        hospital_sections_status       @default(active)
  content       Json?
  created_at    DateTime                       @default(now()) @db.Timestamp(0)
  updated_at    DateTime                       @default(now()) @db.Timestamp(0)
  hospitals     hospitals                      @relation(fields: [hospital_id], references: [id], onDelete: Cascade, map: "fk_hospital_sections_hospital")

  @@index([hospital_id], map: "idx_hospital_sections_hospital_id")
  @@index([section_order], map: "idx_hospital_sections_section_order")
  @@index([status], map: "idx_hospital_sections_status")
}

enum hospital_sections_section_type {
  hero
  overview
  why_choose_us
  cta
  disclaimer
  custom
}

enum hospital_sections_status {
  active
  inactive
}

/**
 * Nationwide insurance-provider taxonomy — same shape/role as
 * `doctor_specialities` relative to `doctors` (a shared, reusable
 * entity many hospitals independently reference), not a per-hospital
 * free-text field. `name`/`seo_url` both unique so the same provider is
 * never duplicated under a different row.
 */
model insurance_companies {
  id                           Int                            @id @default(autoincrement()) @db.UnsignedInt
  name                         String                         @unique(map: "uq_insurance_companies_name") @db.VarChar(255)
  seo_url                      String                         @unique(map: "uq_insurance_companies_seo_url") @db.VarChar(255)
  logo                         String?                        @db.VarChar(500)
  description                  String?                        @db.Text
  status                       insurance_companies_status     @default(active)
  created_at                   DateTime                       @default(now()) @db.Timestamp(0)
  updated_at                   DateTime                       @default(now()) @db.Timestamp(0)
  hospital_insurance_companies hospital_insurance_companies[]

  @@index([status], map: "idx_insurance_companies_status")
}

enum insurance_companies_status {
  active
  inactive
}

/**
 * Hospital ↔ Insurance Company junction — mirrors `doctor_hospitals`'
 * composite-relationship shape conceptually, but keeps its own surrogate
 * `id` (rather than a composite PK) specifically so `sorting_order` and
 * `status` can live on the mapping row itself (a composite-PK junction
 * table has no natural place to hang per-row mutable state). The
 * `@@unique([hospital_id, insurance_company_id])` constraint is what
 * actually prevents a duplicate mapping — never relied on the admin UI
 * alone to enforce that.
 */
model hospital_insurance_companies {
  id                   Int                                 @id @default(autoincrement()) @db.UnsignedInt
  hospital_id          Int                                 @db.UnsignedInt
  insurance_company_id Int                                 @db.UnsignedInt
  sorting_order        Int                                 @default(0)
  status               hospital_insurance_companies_status @default(active)
  created_at           DateTime                            @default(now()) @db.Timestamp(0)
  updated_at           DateTime                            @default(now()) @db.Timestamp(0)
  hospitals            hospitals                           @relation(fields: [hospital_id], references: [id], onDelete: Cascade, map: "fk_hospital_insurance_companies_hospital")
  insurance_companies  insurance_companies                 @relation(fields: [insurance_company_id], references: [id], onDelete: Cascade, map: "fk_hospital_insurance_companies_insurance_company")

  @@unique([hospital_id, insurance_company_id], map: "uq_hospital_insurance_companies_mapping")
  @@index([insurance_company_id], map: "idx_hospital_insurance_companies_insurance_company_id")
  @@index([sorting_order], map: "idx_hospital_insurance_companies_sorting_order")
  @@index([status], map: "idx_hospital_insurance_companies_status")
}

enum hospital_insurance_companies_status {
  active
  inactive
}

model international_patient_leads {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name       String    @db.VarChar(150)
  age        Int?      @db.UnsignedInt
  gender     String?   @db.VarChar(50)
  country    String?   @db.VarChar(100)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime  @default(now()) @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)

  @@index([country], map: "idx_international_patient_leads_country")
  @@index([created_at], map: "idx_international_patient_leads_created_at")
}

model js_configurations {
  id          Int                          @id @default(autoincrement()) @db.UnsignedInt
  config_for  js_configurations_config_for
  config_type String                       @db.VarChar(100)
  config_code String                       @db.LongText
  status      js_configurations_status     @default(active)
  created_at  DateTime                     @default(now()) @db.Timestamp(0)
  updated_at  DateTime                     @default(now()) @db.Timestamp(0)

  @@index([config_for], map: "idx_js_configurations_config_for")
  @@index([status], map: "idx_js_configurations_status")
}

/// Provider-agnostic AI configuration — the admin can save several
/// provider configs but only one may be `is_active` at a time (enforced in
/// services/ai-configuration.service.ts's activateAIConfiguration, not at
/// the DB level, matching how other cross-row invariants like the menu
/// parent-cycle check are enforced in the service layer). `status` is the
/// standard soft-delete flag; `is_active` is a separate concept — "is this
/// the one currently live provider" — deliberately not collapsed into
/// `status`. `encrypted_api_key` is an AES-256-GCM envelope
/// (lib/ai/encryption.ts), never the plaintext key; nullable because a row
/// can exist before a key has been entered.
model ai_configurations {
  id                Int                        @id @default(autoincrement()) @db.UnsignedInt
  provider          ai_configurations_provider
  base_url          String                     @db.VarChar(500)
  model             String                     @db.VarChar(255)
  encrypted_api_key String?                    @db.Text
  is_active         Boolean                    @default(false)
  status            ai_configurations_status   @default(active)
  created_at        DateTime                   @default(now()) @db.Timestamp(0)
  updated_at        DateTime                   @default(now()) @db.Timestamp(0)

  @@index([provider], map: "idx_ai_configurations_provider")
  @@index([is_active], map: "idx_ai_configurations_is_active")
}

/// Single-row table (service always upserts id=1) holding the public
/// website's admin-editable design tokens as one JSON map — the same
/// "flexible content as Json" convention already used by
/// treatment_sections.content/speciality_sections.content rather than one
/// rigid column per color. Separate from js_configurations/
/// ai_configurations: neither is a generic settings table, and this has no
/// create/delete semantics (view + update only).
model website_theme_settings {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tokens     Json
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

/// Single-row table (service always upserts id=1) holding the two
/// admin-editable marketing strings shown on the shared public
/// AppointmentLeadForm. Explicit columns (not a Json blob like
/// website_theme_settings above) since this is exactly two fixed,
/// independently-typed fields with no variable shape — matches
/// ai_configurations' explicit-column convention rather than the
/// flexible-content Json pattern, which is for genuinely structured/
/// variable content.
model consultation_form_settings {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  form_title       String   @db.VarChar(255)
