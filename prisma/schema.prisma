/// Single-row table (service always upserts id=1) holding everything admins can edit on the public /contact-us page except the form itself (which stays in consultation_form_settings, the single source of truth for the form). contact_items is the ordered list of icon/label/value rows; validated by validators/contact-page-settings.validator.ts on every write and re-validated on every read.
model contact_page_settings {
  id                   Int      @id @default(autoincrement()) @db.UnsignedInt
  badge_text           String?  @db.VarChar(100)
  heading              String   @db.VarChar(255)
  description          String   @db.VarChar(500)
  show_badge           Boolean  @default(true)
  show_contact_details Boolean  @default(true)
  form_position        String   @default("right") @db.VarChar(10)
  show_form_heading    Boolean  @default(false)
  contact_items        Json?
  meta_title           String?  @db.VarChar(255)
  meta_description     String?  @db.Text
  meta_keyword         String?  @db.VarChar(500)
  created_at           DateTime @default(now()) @db.Timestamp(0)
  updated_at           DateTime @default(now()) @db.Timestamp(0)
}

/// Single-row table (service always upserts id=1) behind Admin -> Settings -> Footer Settings: everything in the public footer except its three colours (those live in website_theme_settings / Website Appearance). `columns`, `contact_items`, `social_links` and `bottom_links` are JSON, validated by validators/footer-settings.validator.ts on every write and re-validated on every read. A missing row means "never customised" and the built-in defaults (the original footer) apply.
model footer_settings {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  brand_primary    String   @db.VarChar(100)
  brand_accent     String?  @db.VarChar(100)
  logo             String?  @db.VarChar(500)
  description      String   @db.VarChar(1000)
  cta_enabled      Boolean  @default(true)
  cta_heading      String   @db.VarChar(255)
  cta_description  String   @db.VarChar(500)
  cta_button_label String   @db.VarChar(100)
  cta_button_url   String?  @db.VarChar(500)
  copyright_text   String   @db.VarChar(500)
  columns          Json
  contact_items    Json?
  social_links     Json?
  bottom_links     Json?
  created_at       DateTime @default(now()) @db.Timestamp(0)
  updated_at       DateTime @default(now()) @db.Timestamp(0)
}

// Shared sliding-window counters for lib/rate-limit.ts (login, public lead
// form). One row per counted event; `bucket` is a namespaced, hashed key
// (e.g. "login:ip:<sha256>"). Rows older than a day are pruned lazily.
model rate_limit_events {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bucket     String   @db.VarChar(120)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([bucket, created_at], map: "idx_rate_limit_events_bucket_created")
  @@index([created_at], map: "idx_rate_limit_events_created")
}
