/**
 * City-independent "global" content for a treatment concept — e.g.
 * "Hernia Surgery" in general, shown at the city-less `/dcg/{seoUrl}` route.
 * Deliberately NOT derived from, copied from, or linked to any single
 * city `treatments` row — it is independently authored in its own CMS
 * module. A city's own `treatments` row may optionally point back at one
 * of these via `treatments.global_treatment_id` (nullable — most rows
 * start and may stay unlinked), which is the ONLY relationship between
 * the two; no field value ever flows between them.
 */
model global_treatments {
  id                                      Int                                       @id @default(autoincrement()) @db.UnsignedInt
  treatment_name                          String                                    @db.VarChar(255)
  treatment_title                         String?                                   @db.VarChar(255)
  seo_url                                 String                                    @unique(map: "uq_global_treatments_seo_url") @db.VarChar(255)
  short_description                       String?                                   @db.Text
  description                             String?                                   @db.LongText
  image                                   String?                                   @db.VarChar(500)
  // Compact listing-card icon — independent of `image` (the detail-page hero). NULL = fall back to the default card icon, never to `image`.
  card_icon                               String?                                   @db.VarChar(500)
  meta_title                              String?                                   @db.VarChar(255)
  meta_description                        String?                                   @db.Text
  meta_keyword                            String?                                   @db.VarChar(500)
  // Optional link to this global treatment's own city-independent global
  // speciality (NOT the same as `treatments.speciality_id`, which is a
  // CITY-scoped FK) — nullable, admin-set only, never auto-matched. When
  // set, this treatment's canonical public URL becomes
  // `/dcg/{global_specialities.seo_url}/{seo_url}` instead of
  // `/dcg/{seo_url}`. See lib/public/urls.ts's getGlobalTreatmentUrl().
  global_speciality_id                    Int?                                      @db.UnsignedInt
  status                                  global_treatments_status                  @default(active)
  created_at                              DateTime                                  @default(now()) @db.Timestamp(0)
  updated_at                              DateTime                                  @default(now()) @db.Timestamp(0)
  global_treatment_sections               global_treatment_sections[]
  global_treatment_faqs                   global_treatment_faqs[]
  treatments                              treatments[]
  blog_global_treatment_mappings          blog_global_treatment_mappings[]
  blog_category_global_treatment_mappings blog_category_global_treatment_mappings[]
  global_specialities                     global_specialities?                     @relation(fields: [global_speciality_id], references: [id], onDelete: SetNull, map: "fk_global_treatments_global_speciality")

  @@index([status], map: "idx_global_treatments_status")
  @@index([global_speciality_id], map: "idx_global_treatments_global_speciality_id")
}

/**
 * Freeform admin-authored content blocks for a `global_treatments` row — this entity has no fixed/city-bound section kinds (no hero/symptoms/doctors/hospital — those are inherently city concepts), so unlike `treatment_sections` there is no polymorphic `section_type`/`content Json?`: every row here is one ordered, titled rich-text block.
 */
model global_treatment_sections {
  id                  Int                              @id @default(autoincrement()) @db.UnsignedInt
  global_treatment_id Int                              @db.UnsignedInt
  title               String                           @db.VarChar(255)
  content             String?                          @db.LongText
  image               String?                          @db.VarChar(500)
  section_order       Int                              @default(0)
  status              global_treatment_sections_status @default(active)
  created_at          DateTime                         @default(now()) @db.Timestamp(0)
  updated_at          DateTime                         @default(now()) @db.Timestamp(0)
  global_treatments   global_treatments                @relation(fields: [global_treatment_id], references: [id], onDelete: Cascade, map: "fk_global_treatment_sections_treatment")

  @@index([global_treatment_id], map: "idx_global_treatment_sections_treatment_id")
  @@index([status], map: "idx_global_treatment_sections_status")
  @@index([section_order], map: "idx_global_treatment_sections_sorting_order")
}

model global_treatment_faqs {
  id                  Int                          @id @default(autoincrement()) @db.UnsignedInt
  global_treatment_id Int                          @db.UnsignedInt
  title               String                       @db.VarChar(255)
  text                String                       @db.Text
  status              global_treatment_faqs_status @default(active)
  created_at          DateTime                     @default(now()) @db.Timestamp(0)
  updated_at          DateTime                     @default(now()) @db.Timestamp(0)
  global_treatments   global_treatments            @relation(fields: [global_treatment_id], references: [id], onDelete: Cascade, map: "fk_global_treatment_faqs_treatment")

  @@index([global_treatment_id], map: "idx_global_treatment_faqs_treatment_id")
  @@index([status], map: "idx_global_treatment_faqs_status")
}

/**
 * Speciality's own global/city-independent equivalent — same architecture and the same non-negotiable rule as `global_treatments`: never derived from a city `specialities` row.
 */
model global_specialities {
  id                                       Int                                        @id @default(autoincrement()) @db.UnsignedInt
  speciality_name                          String                                     @db.VarChar(255)
  speciality_title                         String?                                    @db.VarChar(255)
  seo_url                                  String                                     @unique(map: "uq_global_specialities_seo_url") @db.VarChar(255)
  short_description                        String?                                    @db.Text
  description                              String?                                    @db.LongText
  image                                    String?                                    @db.VarChar(500)
  // Compact listing-card icon - independent of `image` (the detail-page hero). NULL = default card icon, never the hero.
  card_icon                                String?                                    @db.VarChar(500)
  meta_title                               String?                                    @db.VarChar(255)
  meta_description                         String?                                    @db.Text
  meta_keyword                             String?                                    @db.VarChar(500)
  status                                   global_specialities_status                 @default(active)
  created_at                               DateTime                                   @default(now()) @db.Timestamp(0)
  updated_at                               DateTime                                   @default(now()) @db.Timestamp(0)
  global_speciality_sections               global_speciality_sections[]
  global_speciality_faqs                   global_speciality_faqs[]
  specialities                             specialities[]
  blog_global_speciality_mappings          blog_global_speciality_mappings[]
  blog_category_global_speciality_mappings blog_category_global_speciality_mappings[]
  global_treatments                        global_treatments[]

  @@index([status], map: "idx_global_specialities_status")
}

/**
 * Many-to-many: which blogs are explicitly Related Reading for a given global speciality. The sole source of truth for that relationship — public pages never fall back to category/city/keyword matching (see lib/public/global-content.ts, lib/public/specialities.ts).
 */
model blog_global_speciality_mappings {
  blog_id              Int                 @db.UnsignedInt
  global_speciality_id Int                 @db.UnsignedInt
  blogs                blogs               @relation(fields: [blog_id], references: [id], onDelete: Cascade, map: "fk_blog_gs_mappings_blog")
  global_specialities  global_specialities @relation(fields: [global_speciality_id], references: [id], onDelete: Cascade, map: "fk_blog_gs_mappings_speciality")

  @@id([blog_id, global_speciality_id])
  @@index([global_speciality_id], map: "idx_blog_gs_mappings_speciality_id")
}

/**
 * Many-to-many: which blogs are explicitly Related Reading for a given global treatment. Mirrors blog_global_speciality_mappings exactly — see that model's own doc comment.
 */
model blog_global_treatment_mappings {
  blog_id             Int               @db.UnsignedInt
  global_treatment_id Int               @db.UnsignedInt
  blogs               blogs             @relation(fields: [blog_id], references: [id], onDelete: Cascade, map: "fk_blog_gt_mappings_blog")
  global_treatments   global_treatments @relation(fields: [global_treatment_id], references: [id], onDelete: Cascade, map: "fk_blog_gt_mappings_treatment")

  @@id([blog_id, global_treatment_id])
  @@index([global_treatment_id], map: "idx_blog_gt_mappings_treatment_id")
}

model global_speciality_sections {
