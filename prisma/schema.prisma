model pages {
  id               Int             @id @default(autoincrement()) @db.UnsignedInt
  language_id      Int             @db.UnsignedInt
  title            String          @db.VarChar(255)
  seo_url          String          @unique(map: "uq_pages_seo_url") @db.VarChar(255)
  meta_title       String?         @db.VarChar(255)
  meta_description String?         @db.Text
  meta_keyword     String?         @db.VarChar(500)
  category         String          @db.VarChar(100)
  // Where this page's link appears in the public footer: the Company column, the bottom legal bar, or nowhere. Replaces the old slug-keyword guess.
  footer_placement pages_footer_placement @default(company)
  // NULL = a GLOBAL page (city-independent) - the same convention `menus.city_id` uses. A city-specific page always has a real city.
  city_id          Int?            @db.UnsignedInt
  location_id      Int?            @db.UnsignedInt
  // Legacy single rich-text field — kept for backward compatibility.
  // New pages should use `page_sections` instead; the public renderer
  // prefers active sections and only falls back to `body` when a page
  // has none.
  body             String?         @db.LongText
  status           pages_status    @default(active)
  created_at       DateTime        @default(now()) @db.Timestamp(0)
  updated_at       DateTime        @default(now()) @db.Timestamp(0)
  // Restrict (not SetNull): deleting a city must never silently turn its pages global.
  cities           cities?         @relation(fields: [city_id], references: [id], onDelete: Restrict, map: "fk_pages_city")
  languages        languages       @relation(fields: [language_id], references: [id], map: "fk_pages_language")
  locations        locations?      @relation(fields: [location_id], references: [id], onDelete: Restrict, map: "fk_pages_location")
  page_sections    page_sections[]

  @@index([category], map: "idx_pages_category")
  @@index([city_id], map: "idx_pages_city_id")
  @@index([language_id], map: "idx_pages_language_id")
  @@index([location_id], map: "idx_pages_location_id")
  @@index([status], map: "idx_pages_status")
}

/**
 * A structured, reorderable, controlled content block belonging to one
 * `pages` row. `content` holds the section-type-specific fields as JSON
 * (validated per-type at the application layer, in
 * validators/page-section.validator.ts) rather than dozens of nullable
 * columns on this table — the set of section types is small and fixed
 * (hero/about/features/content/cta), so a single typed JSON column is
 * simpler than one column per possible field across every type.
 */
model page_sections {
  id            Int                        @id @default(autoincrement()) @db.UnsignedInt
  page_id       Int                        @db.UnsignedInt
  section_type  page_sections_section_type
  section_order Int                        @default(0)
  status        page_sections_status       @default(active)
  content       Json
  created_at    DateTime                   @default(now()) @db.Timestamp(0)
  updated_at    DateTime                   @default(now()) @db.Timestamp(0)
  pages         pages                      @relation(fields: [page_id], references: [id], onDelete: Cascade, map: "fk_page_sections_page")

  @@index([page_id], map: "idx_page_sections_page_id")
  @@index([section_order], map: "idx_page_sections_section_order")
  @@index([status], map: "idx_page_sections_status")
}

model specialities {
  id                   Int                   @id @default(autoincrement()) @db.UnsignedInt
  speciality_name      String                @db.VarChar(255)
  speciality_title     String?               @db.VarChar(255)
  seo_url              String                @unique(map: "uq_specialities_seo_url") @db.VarChar(255)
  meta_title           String?               @db.VarChar(255)
  meta_description     String?               @db.Text
  meta_keyword         String?               @db.VarChar(500)
  city_id              Int                   @db.UnsignedInt
  location_id          Int?                  @db.UnsignedInt
  hospital_id          Int?                  @db.UnsignedInt
  speciality_logo      String?               @db.VarChar(500)
  // Compact listing-card icon - independent of `speciality_logo` (the detail-page hero). NULL = default card icon, never the hero.
  card_icon            String?               @db.VarChar(500)
  short_description    String?               @db.Text
  parent_speciality_id Int?                  @db.UnsignedInt
  keywords_for_doctors String?               @db.VarChar(500)
  status               specialities_status   @default(active)
  ai_content_generator Boolean               @default(false)
  description          String?               @db.LongText
  // Optional link from this clinical speciality to the nationwide doctor
  // taxonomy (e.g. "Proctology" here -> "Proctologist" there) — the ONLY
  // relationship connecting specialities to doctors at all; nullable and
  // SetNull-on-delete since a speciality is fully valid with no doctors
  // section configured. Many specialities rows (one per city) can point at
  // the same doctor_specialities row, since that side is nationwide.
  doctor_speciality_id Int?                  @db.UnsignedInt
  // Optional link to this speciality's city-independent "global" concept
  // (see `global_specialities`'s own doc comment) — nullable, admin-set
  // only, never auto-matched/backfilled. Purely a discovery pointer: no
  // content ever flows from this row to the global one or back.
  global_speciality_id Int?                  @db.UnsignedInt
  created_at           DateTime              @default(now()) @db.Timestamp(0)
  updated_at           DateTime              @default(now()) @db.Timestamp(0)
  doctor_pages         doctor_pages[]
  cities               cities                @relation(fields: [city_id], references: [id], map: "fk_specialities_city")
  hospitals            hospitals?            @relation(fields: [hospital_id], references: [id], onDelete: Restrict, map: "fk_specialities_hospital")
  locations            locations?            @relation(fields: [location_id], references: [id], onDelete: Restrict, map: "fk_specialities_location")
  specialities         specialities?         @relation("specialitiesTospecialities", fields: [parent_speciality_id], references: [id], onDelete: Restrict, map: "fk_specialities_parent")
  other_specialities   specialities[]        @relation("specialitiesTospecialities")
  doctor_specialities  doctor_specialities?  @relation(fields: [doctor_speciality_id], references: [id], onDelete: SetNull, map: "fk_specialities_doctor_speciality")
  global_specialities  global_specialities?  @relation(fields: [global_speciality_id], references: [id], onDelete: SetNull, map: "fk_specialities_global_speciality")
  speciality_faqs      speciality_faqs[]
  speciality_symptoms  speciality_symptoms[]
  treatments           treatments[]
  speciality_sections  speciality_sections[]
  // Back-relation for testimonials.speciality_id (transition phase — see
  // the patient_specialities/patient_treatments removal plan).
  testimonials         testimonials[]

  @@index([city_id], map: "idx_specialities_city_id")
  @@index([hospital_id], map: "idx_specialities_hospital_id")
  @@index([location_id], map: "idx_specialities_location_id")
  @@index([parent_speciality_id], map: "idx_specialities_parent_id")
  @@index([status], map: "idx_specialities_status")
  @@index([doctor_speciality_id], map: "idx_specialities_doctor_speciality_id")
  @@index([global_speciality_id], map: "idx_specialities_global_speciality_id")
}

