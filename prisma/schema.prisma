/**
 * Presentation/order/enable-disable configuration for the 8 predefined
 * Speciality Content sections, PLUS an unlimited number of admin-authored
 * custom content sections (`section_type = "custom"`) — never a second
 * copy of the underlying content. Hero/Overview/Treatments/Symptoms/
 * Hospital/Doctors/FAQs all read from the EXISTING `specialities` columns
 * and relations; `cta` and `custom` are the only two types with their own
 * `content` JSON.
 * There is deliberately NO `@@unique([speciality_id, section_type])`
 * constraint (removed — previously enforced "exactly one row per type" at
 * the DB level, which is exactly wrong for `custom`, since a speciality
 * can have any number of custom sections). "Exactly one row per fixed
 * type" is instead guaranteed at the application layer by
 * services/speciality-section.service.ts: `getOrCreateSpecialitySections`
 * only ever backfills the 8 fixed types once each, and the only section-
 * creation endpoint (`createSpecialitySection`) always forces
 * `section_type: "custom"` — a fixed-type row can never be created
 * through the API. Every row's real identity is its own `id`, not
 * `section_type` (mirrors `page_sections`' proven identical pattern for
 * Pages, which never had this constraint either).
 */
model speciality_sections {
  id            Int                              @id @default(autoincrement()) @db.UnsignedInt
  speciality_id Int                              @db.UnsignedInt
  section_type  speciality_sections_section_type
  section_order Int                              @default(0)
  status        speciality_sections_status       @default(active)
  content       Json?
  created_at    DateTime                         @default(now()) @db.Timestamp(0)
  updated_at    DateTime                         @default(now()) @db.Timestamp(0)
  specialities  specialities                     @relation(fields: [speciality_id], references: [id], onDelete: Cascade, map: "fk_speciality_sections_speciality")

  @@index([speciality_id], map: "idx_speciality_sections_speciality_id")
  @@index([section_order], map: "idx_speciality_sections_section_order")
  @@index([status], map: "idx_speciality_sections_status")
}

/**
 * Independent Treatment-side mirror of `speciality_sections` — same
 * exact architecture (one JSON `content` column shared by every
 * structured/content-bearing type, `section_type` as a controlled enum,
 * no DB-level uniqueness on (treatment_id, section_type) so unlimited
 * `custom` rows are allowed, application-layer guarantee of exactly one
 * row per fixed type via getOrCreateTreatmentSections()) — deliberately
 * NOT a shared table with `speciality_sections`: Treatment and Speciality
 * stay fully independently managed per the locked architecture decision.
 */
model treatment_sections {
  id            Int                             @id @default(autoincrement()) @db.UnsignedInt
  treatment_id  Int                             @db.UnsignedInt
  section_type  treatment_sections_section_type
  section_order Int                             @default(0)
  status        treatment_sections_status       @default(active)
  content       Json?
  created_at    DateTime                        @default(now()) @db.Timestamp(0)
  updated_at    DateTime                        @default(now()) @db.Timestamp(0)
  treatments    treatments                      @relation(fields: [treatment_id], references: [id], onDelete: Cascade, map: "fk_treatment_sections_treatment")

  @@index([treatment_id], map: "idx_treatment_sections_treatment_id")
  @@index([section_order], map: "idx_treatment_sections_section_order")
  @@index([status], map: "idx_treatment_sections_status")
}

