generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model actions {
  id          Int           @id @default(autoincrement()) @db.UnsignedInt
  name        String        @unique(map: "uq_actions_name") @db.VarChar(50)
  slug        String        @unique(map: "uq_actions_slug") @db.VarChar(50)
  permissions permissions[]
}

model modules {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  parent_id     Int?           @db.UnsignedInt
  name          String         @db.VarChar(100)
  slug          String         @unique(map: "uq_modules_slug") @db.VarChar(100)
  sorting_order Int            @default(0)
  status        modules_status @default(active)
  created_at    DateTime       @default(now()) @db.Timestamp(0)
  updated_at    DateTime       @default(now()) @db.Timestamp(0)
  modules       modules?       @relation("modulesTomodules", fields: [parent_id], references: [id], onDelete: Restrict, map: "fk_modules_parent")
  other_modules modules[]      @relation("modulesTomodules")
  permissions   permissions[]

  @@index([parent_id], map: "fk_modules_parent")
}

model permissions {
  id               Int                @id @default(autoincrement()) @db.UnsignedInt
  module_id        Int                @db.UnsignedInt
  action_id        Int                @db.UnsignedInt
  name             String             @unique(map: "uq_permissions_name") @db.VarChar(150)
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  actions          actions            @relation(fields: [action_id], references: [id], onDelete: Cascade, map: "fk_permissions_action")
  modules          modules            @relation(fields: [module_id], references: [id], onDelete: Cascade, map: "fk_permissions_module")
  role_permissions role_permissions[]

  @@unique([module_id, action_id], map: "uq_permissions_module_action")
  @@index([action_id], map: "fk_permissions_action")
}

model role_permissions {
  role_id       Int         @db.UnsignedInt
  permission_id Int         @db.UnsignedInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_role_permissions_permission")
}

model roles {
  id               Int                @id @default(autoincrement()) @db.UnsignedInt
  name             String             @unique(map: "uq_roles_name") @db.VarChar(100)
  description      String?            @db.VarChar(255)
  status           roles_status       @default(active)
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  updated_at       DateTime           @default(now()) @db.Timestamp(0)
  role_permissions role_permissions[]
  users            users[]
}

model users {
  id         Int          @id @default(autoincrement()) @db.UnsignedInt
  name       String       @db.VarChar(150)
  email      String       @unique(map: "uq_users_email") @db.VarChar(255)
  password   String       @db.VarChar(255)
  role_id    Int          @db.UnsignedInt
  status     users_status @default(active)
  // Bumped to revoke every outstanding session JWT of this user (logout, password change).
  session_version Int     @default(0) @db.UnsignedInt
  created_at DateTime     @default(now()) @db.Timestamp(0)
  updated_at DateTime     @default(now()) @db.Timestamp(0)
  roles      roles        @relation(fields: [role_id], references: [id], map: "fk_users_role")

  @@index([role_id], map: "idx_users_role_id")
}

model appointment_leads {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  first_name   String    @db.VarChar(100)
  last_name    String    @db.VarChar(100)
  email        String    @db.VarChar(255)
  phone_number String    @db.VarChar(30)
  // Set by the configurable consultation form. Deliberately plain columns, NOT
  // foreign keys — a lead is historical data and must survive a city/treatment
  // being deleted or deactivated. Display-name snapshots live in extra_data.
  city_id             Int?      @db.UnsignedInt
  treatment_id        Int?      @db.UnsignedInt // a city-scoped `treatments` row
  global_treatment_id Int?      @db.UnsignedInt // a `global_treatments` row
  // Every answer to a non-column field (custom admin-added fields + the
  // city/treatment label snapshots), as [{ key, label, value }] — so renaming
  // or removing a form field later never loses what a visitor submitted.
  extra_data   Json?
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  updated_at   DateTime  @default(now()) @db.Timestamp(0)
  deleted_at   DateTime? @db.Timestamp(0)

  @@index([created_at], map: "idx_appointment_leads_created_at")
  @@index([city_id], map: "idx_appointment_leads_city_id")
  @@index([email], map: "idx_appointment_leads_email")
}

model banners {
  id                  Int            @id @default(autoincrement()) @db.UnsignedInt
  banner_name         String         @db.VarChar(255)
  banner_url          String?        @db.VarChar(500)
  banner_image        String         @db.VarChar(500)
  mobile_banner_image String?        @db.VarChar(500)
  city_id             Int            @db.UnsignedInt
  sorting_order       Int            @default(0)
  status              banners_status @default(active)
  created_at          DateTime       @default(now()) @db.Timestamp(0)
  updated_at          DateTime       @default(now()) @db.Timestamp(0)
  cities              cities         @relation(fields: [city_id], references: [id], map: "fk_banners_city")

  @@index([city_id], map: "idx_banners_city_id")
  @@index([sorting_order], map: "idx_banners_sorting_order")
  @@index([status], map: "idx_banners_status")
}

model blog_categories {
  id                                       Int                                        @id @default(autoincrement()) @db.UnsignedInt
  category_name                            String                                     @db.VarChar(255)
  meta_title                               String?                                    @db.VarChar(255)
  meta_description                         String?                                    @db.Text
  meta_keywords                            String?                                    @db.VarChar(500)
  seo_url                                  String                                     @unique(map: "uq_blog_categories_seo_url") @db.VarChar(255)
  status                                   blog_categories_status                     @default(active)
  created_at                               DateTime                                   @default(now()) @db.Timestamp(0)
  updated_at                               DateTime                                   @default(now()) @db.Timestamp(0)
  blogs                                    blogs[]
  blog_category_global_speciality_mappings blog_category_global_speciality_mappings[]
  blog_category_global_treatment_mappings  blog_category_global_treatment_mappings[]

  @@index([status], map: "idx_blog_categories_status")
}

/**
 * Many-to-many: the DEFAULT Related Reading specialities for every blog in this category — only used as a fallback when a blog has no explicit speciality association of its own (see blog_global_speciality_mappings and services/blog.service.ts's getBlogs()).
 */
model blog_category_global_speciality_mappings {
  blog_category_id     Int                 @db.UnsignedInt
  global_speciality_id Int                 @db.UnsignedInt
  blog_categories      blog_categories     @relation(fields: [blog_category_id], references: [id], onDelete: Cascade, map: "fk_blog_cat_gs_mappings_category")
  global_specialities  global_specialities @relation(fields: [global_speciality_id], references: [id], onDelete: Cascade, map: "fk_blog_cat_gs_mappings_speciality")

  @@id([blog_category_id, global_speciality_id])
  @@index([global_speciality_id], map: "idx_blog_cat_gs_mappings_speciality_id")
}

/**
 * Many-to-many: the DEFAULT Related Reading treatments for every blog in this category — same fallback-only role as blog_category_global_speciality_mappings above.
 */
model blog_category_global_treatment_mappings {
  blog_category_id    Int               @db.UnsignedInt
  global_treatment_id Int               @db.UnsignedInt
  blog_categories     blog_categories   @relation(fields: [blog_category_id], references: [id], onDelete: Cascade, map: "fk_blog_cat_gt_mappings_category")
  global_treatments   global_treatments @relation(fields: [global_treatment_id], references: [id], onDelete: Cascade, map: "fk_blog_cat_gt_mappings_treatment")

  @@id([blog_category_id, global_treatment_id])
  @@index([global_treatment_id], map: "idx_blog_cat_gt_mappings_treatment_id")
}

model blog_faqs {
  id            Int              @id @default(autoincrement()) @db.UnsignedInt
  blog_id       Int              @db.UnsignedInt
  title         String           @db.VarChar(255)
  text          String           @db.Text
  sorting_order Int              @default(0)
  status        blog_faqs_status @default(active)
  created_at    DateTime         @default(now()) @db.Timestamp(0)
  updated_at    DateTime         @default(now()) @db.Timestamp(0)
  blogs         blogs            @relation(fields: [blog_id], references: [id], onDelete: Cascade, map: "fk_blog_faqs_blog")

  @@index([blog_id], map: "idx_blog_faqs_blog_id")
  @@index([status], map: "idx_blog_faqs_status")
  @@index([sorting_order], map: "idx_blog_faqs_sorting_order")
}

model blogs {
  id                              Int                               @id @default(autoincrement()) @db.UnsignedInt
  blog_category_id                Int                               @db.UnsignedInt
  blog_title                      String                            @db.VarChar(255)
  meta_title                      String?                           @db.VarChar(255)
  meta_description                String?                           @db.Text
  meta_keywords                   String?                           @db.VarChar(500)
  seo_url                         String                            @unique(map: "uq_blogs_seo_url") @db.VarChar(255)
  language_id                     Int                               @db.UnsignedInt
  // NULL = a GLOBAL blog (not tied to any city) - the same convention `pages.city_id` / `menus.city_id` use. A city blog always has a real city.
  city_id                         Int?                              @db.UnsignedInt
  blog_image                      String?                           @db.VarChar(500)
  published_date                  DateTime?                         @db.DateTime(0)
  search_keywords_for_doctors     String?                           @db.VarChar(500)
  blog_status                     blogs_blog_status                 @default(active)
  ai_content_generator            Boolean                           @default(false)
  blog_text                       String?                           @db.LongText
  author_name                     String?                           @db.VarChar(255)
  author_image                    String?                           @db.VarChar(500)
  is_featured                     Boolean                           @default(false)
  created_at                      DateTime                          @default(now()) @db.Timestamp(0)
  updated_at                      DateTime                          @default(now()) @db.Timestamp(0)
  blog_faqs                       blog_faqs[]
  blog_categories                 blog_categories                   @relation(fields: [blog_category_id], references: [id], map: "fk_blogs_category")
  // Restrict (not SetNull): deleting a city must never silently turn its blogs global.
  cities                          cities?                           @relation(fields: [city_id], references: [id], onDelete: Restrict, map: "fk_blogs_city")
  languages                       languages                         @relation(fields: [language_id], references: [id], map: "fk_blogs_language")
  blog_global_speciality_mappings blog_global_speciality_mappings[]
  blog_global_treatment_mappings  blog_global_treatment_mappings[]

  @@index([blog_category_id], map: "idx_blogs_category_id")
  @@index([city_id], map: "idx_blogs_city_id")
  @@index([language_id], map: "idx_blogs_language_id")
  @@index([published_date], map: "idx_blogs_published_date")
  @@index([blog_status], map: "idx_blogs_status")
  @@index([is_featured], map: "idx_blogs_is_featured")
}

model bookaform_data {
  id         Int                   @id @default(autoincrement()) @db.UnsignedInt
  data_from  String                @db.VarChar(255)
  status     bookaform_data_status @default(active)
  created_at DateTime              @default(now()) @db.Timestamp(0)
  updated_at DateTime              @default(now()) @db.Timestamp(0)

  @@index([status], map: "idx_bookaform_data_status")
}

model cities {
  id               Int            @id @default(autoincrement()) @db.UnsignedInt
  language_id      Int            @db.UnsignedInt
  city_name        String         @db.VarChar(150)
  meta_title       String?        @db.VarChar(255)
  meta_description String?        @db.Text
  meta_keywords    String?        @db.VarChar(500)
  seo_url          String         @unique(map: "uq_cities_seo_url") @db.VarChar(255)
  status           cities_status  @default(active)
  created_at       DateTime       @default(now()) @db.Timestamp(0)
  updated_at       DateTime       @default(now()) @db.Timestamp(0)
  banners                 banners[]
  blogs                   blogs[]
  languages               languages                 @relation(fields: [language_id], references: [id], map: "fk_cities_language")
  doctor_pages            doctor_pages[]
  doctors                 doctors[]
  hospitals               hospitals[]
  locations               locations[]
  menus                   menus[]
  pages                   pages[]
  specialities            specialities[]
  testimonials            testimonials[]
  treatments              treatments[]
  homepage_icon_settings  homepage_icon_settings[]

  @@index([language_id], map: "idx_cities_language_id")
  @@index([status], map: "idx_cities_status")
}

/**
 * Admin-configurable icon choices for the three homepage sections (Hero
 * Statistics row, Why Choose Day Care Surgeries, Our Locations). Exactly
 * one row has `city_id: null` — the GLOBAL defaults row, always accessed
 * by its fixed `id = 1`, same "single-row, service-enforced" convention
 * `website_theme_settings` already uses (see that model's own doc
 * comment) — never a second global row. Every OTHER row has a real,
 * unique `city_id` and holds that one city's overrides ONLY for the keys
 * an admin explicitly set; a key absent from `icons` means "not
 * overridden — inherit the global row's value for that key, or the
 * hardcoded safe default if the global row has none either." `icons` is
 * a partial `Record<IconKey, HomepageIconValue>` — intentionally Json,
 * like `website_theme_settings.tokens`, since both are "a flexible map
 * of named values," not a fixed set of dedicated columns. Each stored
 * value is a tagged union (`{type: "lucide", name}` or `{type: "custom",
 * assetId}`, see types/homepage-icon-settings.ts) — never a bare string
 * — so a Lucide icon name can never be confused with a reference into
 * `homepage_custom_icons` below. A legacy plain-string value (written
 * before this distinction existed) is still read correctly: the service
 * layer treats it as `{type: "lucide", name: <that string>}`.
 */
model homepage_icon_settings {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  city_id    Int?     @db.UnsignedInt
  icons      Json
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  cities     cities?  @relation(fields: [city_id], references: [id], onDelete: Cascade, map: "fk_homepage_icon_settings_city")

  @@unique([city_id], map: "uq_homepage_icon_settings_city_id")
}

/**
 * Admin-uploaded custom icon assets for Homepage Icons — a small,
 * feature-scoped asset registry, not a general-purpose media library
 * (this project has none; every other upload — doctor photos, hospital
 * images, global treatment images, … — stores its path directly on the
 * owning row, with no separate media table at all). A dedicated table is
 * needed here specifically because one uploaded icon can be referenced
 * by MANY `homepage_icon_settings` rows/keys at once (the global row,
 * any number of city overrides, across all three sections) — storing a
 * real database id (not a path string) is what the "typed, validated
 * representation" requirement in `HomepageIconValue` actually depends
 * on; the file itself is still stored via the existing `storageProvider`
 * abstraction (lib/storage), same as every other upload.
 *
 * `file_name` is the original uploaded filename, kept for display only
 * (never used to build a path — `storageProvider.upload()` always
 * returns a randomized path, same as every other upload in this
 * project). `width`/`height` are null for a vector SVG upload (no
 * intrinsic pixel size); always set for a raster upload (PNG/WebP/JPEG),
 * extracted server-side at upload time, never trusted from the client.
 * No `status`/soft-delete column: deleting a referenced asset is
 * refused outright by the service layer (see
 * `services/homepage-custom-icon.service.ts`'s `deleteHomepageCustomIcon`
 * — the "do not delete a media asset that is still referenced"
 * requirement), so a row only ever exists while genuinely available to
 * use; an unreferenced one is hard-deleted, not archived.
 */
model homepage_custom_icons {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  file_name  String   @db.VarChar(255)
  path       String   @db.VarChar(500)
  mime_type  String   @db.VarChar(100)
  width      Int?     @db.UnsignedInt
  height     Int?     @db.UnsignedInt
  file_size  Int      @db.UnsignedInt
  /// Unused. A CSS `mask-image`-based theme-recoloring feature briefly
  /// wrote/read this column, but proved unreliable for real uploaded PNGs
  /// (the mask's fill color depended on a CSS custom property with no
  /// static stylesheet fallback, so it could silently render fully
  /// transparent) and was reverted. The public renderer
  /// (`components/public/home/HomepageIconGlyph.tsx`) no longer reads this
  /// field — uploaded icons always render with their own saved colors.
  /// Left in place rather than dropped to avoid an unnecessary migration;
  /// safe to remove in a future cleanup migration if desired.
  recolor    Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_homepage_custom_icons_created_at")
}

/**
 * Doctor-specific Awards & Recognitions — per-doctor only, never shared or
 * generic. Same architecture as `hospital_faqs`/`speciality_faqs` (own
 * table, `doctor_id` FK with cascade delete, soft-delete via `status`).
 */
model doctor_awards {
  id           Int                  @id @default(autoincrement()) @db.UnsignedInt
  doctor_id    Int                  @db.UnsignedInt
  title        String               @db.VarChar(255)
  organization String?              @db.VarChar(255)
  award_year   String?              @db.VarChar(50)
  description  String?              @db.Text
  status       doctor_awards_status @default(active)
  created_at   DateTime             @default(now()) @db.Timestamp(0)
  updated_at   DateTime             @default(now()) @db.Timestamp(0)
  doctors      doctors              @relation(fields: [doctor_id], references: [id], onDelete: Cascade, map: "fk_doctor_awards_doctor")

  @@index([doctor_id], map: "idx_doctor_awards_doctor_id")
  @@index([status], map: "idx_doctor_awards_status")
}

/**
 * Doctor-specific FAQs — per-doctor only. Same `title`/`text` shape as
 * every other `*_faqs` table in this schema (`hospital_faqs`,
 * `speciality_faqs`, `treatment_faqs`, `global_treatment_faqs`): `title`
 * is the question, `text` is the plain-text answer. Deliberately NOT
 * rich/HTML text — no `*_faqs` table in this schema stores HTML, so this
 * stays consistent rather than introducing a one-off rich-text answer
 * field.
 */
model doctor_faqs {
  id         Int               @id @default(autoincrement()) @db.UnsignedInt
  doctor_id  Int               @db.UnsignedInt
  title      String            @db.VarChar(255)
  text       String            @db.Text
  status     doctor_faqs_status @default(active)
  created_at DateTime          @default(now()) @db.Timestamp(0)
  updated_at DateTime          @default(now()) @db.Timestamp(0)
  doctors    doctors           @relation(fields: [doctor_id], references: [id], onDelete: Cascade, map: "fk_doctor_faqs_doctor")

  @@index([doctor_id], map: "idx_doctor_faqs_doctor_id")
  @@index([status], map: "idx_doctor_faqs_status")
}

model doctor_hospitals {
  doctor_id   Int       @db.UnsignedInt
  hospital_id Int       @db.UnsignedInt
  doctors     doctors   @relation(fields: [doctor_id], references: [id], onDelete: Cascade, map: "fk_doctor_hospitals_doctor")
  hospitals   hospitals @relation(fields: [hospital_id], references: [id], onDelete: Cascade, map: "fk_doctor_hospitals_hospital")

  @@id([doctor_id, hospital_id])
  @@index([hospital_id], map: "idx_doctor_hospitals_hospital_id")
}

model doctor_pages {
  id               Int                 @id @default(autoincrement()) @db.UnsignedInt
  pagename         String              @db.VarChar(255)
  keyword          String?             @db.VarChar(500)
  meta_title       String?             @db.VarChar(255)
  meta_description String?             @db.Text
  meta_keywords    String?             @db.VarChar(500)
  seo_url          String              @unique(map: "uq_doctor_pages_seo_url") @db.VarChar(255)
  city_id          Int                 @db.UnsignedInt
  location_id      Int?                @db.UnsignedInt
  speciality_id    Int                 @db.UnsignedInt
  description      String?             @db.LongText
  status           doctor_pages_status @default(active)
  created_at       DateTime            @default(now()) @db.Timestamp(0)
  updated_at       DateTime            @default(now()) @db.Timestamp(0)
  cities           cities              @relation(fields: [city_id], references: [id], map: "fk_doctor_pages_city")
  locations        locations?          @relation(fields: [location_id], references: [id], onDelete: Restrict, map: "fk_doctor_pages_location")
  specialities     specialities        @relation(fields: [speciality_id], references: [id], map: "fk_doctor_pages_speciality")

  @@index([city_id], map: "idx_doctor_pages_city_id")
  @@index([location_id], map: "idx_doctor_pages_location_id")
  @@index([speciality_id], map: "idx_doctor_pages_speciality_id")
  @@index([status], map: "idx_doctor_pages_status")
}

model doctor_specialities {
  id                         Int                          @id @default(autoincrement()) @db.UnsignedInt
  language_id                Int                          @db.UnsignedInt
  speciality_name            String                       @db.VarChar(255)
  seo_url                    String                       @unique(map: "uq_doctor_specialities_seo_url") @db.VarChar(255)
  status                     doctor_specialities_status   @default(active)
  created_at                 DateTime                     @default(now()) @db.Timestamp(0)
  updated_at                 DateTime                     @default(now()) @db.Timestamp(0)
  languages                  languages                    @relation(fields: [language_id], references: [id], map: "fk_doctor_specialities_language")
  doctor_speciality_mappings doctor_speciality_mappings[]
  specialities               specialities[]

  @@index([language_id], map: "idx_doctor_specialities_language_id")
  @@index([status], map: "idx_doctor_specialities_status")
}

model doctor_speciality_mappings {
  doctor_id            Int                 @db.UnsignedInt
  doctor_speciality_id Int                 @db.UnsignedInt
  doctors              doctors             @relation(fields: [doctor_id], references: [id], onDelete: Cascade, map: "fk_doctor_specialities_doctor")
  doctor_specialities  doctor_specialities @relation(fields: [doctor_speciality_id], references: [id], onDelete: Cascade, map: "fk_doctor_speciality_mappings_speciality")

  @@id([doctor_id, doctor_speciality_id])
  @@index([doctor_speciality_id], map: "idx_doctor_specialities_speciality_id")
}

model doctors {
  id                         Int                          @id @default(autoincrement()) @db.UnsignedInt
  language_id                Int                          @db.UnsignedInt
  doctor_name                String                       @db.VarChar(255)
  meta_title                 String?                      @db.VarChar(255)
  seo_url                    String                       @unique(map: "uq_doctors_seo_url") @db.VarChar(255)
  meta_description           String?                      @db.Text
  meta_keywords              String?                      @db.VarChar(500)
  qualification              String?                      @db.VarChar(500)
  experience                 String?                      @db.VarChar(255)
  availability               String?                      @db.VarChar(255)
  city_id                    Int                          @db.UnsignedInt
  location_id                Int?                         @db.UnsignedInt
  patient_satisfaction_score Decimal?                     @db.Decimal(5, 2)
  sorting_order              Int                          @default(0)
  doctor_image               String?                      @db.VarChar(500)
  mon_sat_first_timings      String?                      @db.VarChar(255)
  mon_sat_second_timings     String?                      @db.VarChar(255)
  sunday_timings             String?                      @db.VarChar(255)
  time_interval              String?                      @db.VarChar(100)
  location_map               String?                      @db.Text
  doctor_description         String?                      @db.Text
  ai_content_generator       Boolean                      @default(false)
  doc_info                   String?                      @db.LongText
  schema_tags                Json?
  latitude                   Decimal?                     @db.Decimal(10, 8)
  longitude                  Decimal?                     @db.Decimal(11, 8)
  status                     doctors_status               @default(active)
  created_at                 DateTime                     @default(now()) @db.Timestamp(0)
  updated_at                 DateTime                     @default(now()) @db.Timestamp(0)
  doctor_awards              doctor_awards[]
  doctor_faqs                doctor_faqs[]
  doctor_hospitals           doctor_hospitals[]
  doctor_speciality_mappings doctor_speciality_mappings[]
  cities                     cities                       @relation(fields: [city_id], references: [id], map: "fk_doctors_city")
  languages                  languages                    @relation(fields: [language_id], references: [id], map: "fk_doctors_language")
  locations                  locations?                   @relation(fields: [location_id], references: [id], onDelete: Restrict, map: "fk_doctors_location")
  testimonials               testimonials[]

  @@index([city_id], map: "idx_doctors_city_id")
  @@index([language_id], map: "idx_doctors_language_id")
  @@index([location_id], map: "idx_doctors_location_id")
  @@index([sorting_order], map: "idx_doctors_sorting_order")
  @@index([status], map: "idx_doctors_status")
}

