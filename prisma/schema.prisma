  global_specialities  global_specialities               @relation(fields: [global_speciality_id], references: [id], onDelete: Cascade, map: "fk_global_speciality_sections_speciality")

  @@index([global_speciality_id], map: "idx_global_speciality_sections_speciality_id")
  @@index([status], map: "idx_global_speciality_sections_status")
  @@index([section_order], map: "idx_global_speciality_sections_sorting_order")
}

model global_speciality_faqs {
  id                   Int                           @id @default(autoincrement()) @db.UnsignedInt
  global_speciality_id Int                           @db.UnsignedInt
  title                String                        @db.VarChar(255)
  text                 String                        @db.Text
  status               global_speciality_faqs_status @default(active)
